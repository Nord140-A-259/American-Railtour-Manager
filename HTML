function render(){
  document.getElementById("s-cash").textContent = money(state.cash);
  document.getElementById("s-cash").style.color = state.cash<0 ? "#ff9d9d" : "#ffe9a8";
  document.getElementById("s-rep").innerHTML = state.rep + " <span style='font-size:.6rem;opacity:.8'>"+repTier()+"</span>";
  document.getElementById("s-fleet").textContent = state.locos.length+" / "+state.rakes.length;
  document.getElementById("s-week").textContent = "Wk "+state.week;
  document.getElementById("s-season").textContent = seasonName() + (isFestive()?" 🎄":"");

  const out = state.locos.filter(isBusy).length + state.rakes.filter(isBusy).length;
  const nextBack = [...state.locos, ...state.rakes].filter(isBusy).map(x=>x.busyUntil).sort((a,b)=>a-b)[0];
  document.getElementById("ab-info").innerHTML =
    `<b>Week ${state.week}</b> · ${seasonName()}${isFestive()?" 🎄":""} · `
    + (out ? `${out} item${out>1?'s':''} out on tour${nextBack?` (next back week ${nextBack})`:''}` : `all stock available`);

  const wb = document.getElementById("winBanner");
  if(netWorth() >= 1000000 && !state.won){ state.won = true; save(); }
  wb.innerHTML = state.won
    ? `<div class="win-banner">🏆 Net worth ${money(netWorth())} — you've been named <b>Railtour Operator of the Year!</b> Keep building your empire.</div>`
    : "";

  renderDepot();
  renderMarket();
  renderRun();
  renderWorks();
  renderLedger();
  save();
}

