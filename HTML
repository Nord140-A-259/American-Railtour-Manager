const SEASONS = ["Spring","Summer","Autumn","Winter"];
const SEASON_FACTOR = {Spring:1.0, Summer:1.28, Autumn:1.06, Winter:0.72};

/* ============================ STATE ============================ */
const SAVE_KEY = "uk_railtour_manager_v1";
let state = null;
let sel = {loco:null, rake:null, route:null};
let uid = 1;

function newGame(){
  uid = 1;
  const starterLoco = mkLoco(CATALOG_DIESEL.find(d=>d.key==="c37"), 0.7);
  const starterRake = mkRake(CATALOG_RAKE.find(r=>r.key==="mk1"), 0.75);
  state = {
    cash: 120000,
    rep: 45,
    week: 1,
    locos: [starterLoco],
    rakes: [starterRake],
    activeTours: [],
    ledger: [],
    won: false
  };
  logEntry("Company founded with £120,000, a preserved Class 37 and a Mk1 rake. Good luck!", 0);
  save(); render();
}
function mkLoco(cat, cond){
  return {id:uid++, cat:cat.key, kind: CATALOG_STEAM.includes(cat)?"steam":"diesel",
          name:cat.name, number:cat.number, condition:cond, livery:0, busyUntil:0};
}
function mkRake(cat, cond){ return {id:uid++, cat:cat.key, name:cat.name, condition:cond, busyUntil:0}; }
function catOf(kind, key){
  if(kind==="rake") return CATALOG_RAKE.find(r=>r.key===key);
  return [...CATALOG_STEAM,...CATALOG_DIESEL].find(l=>l.key===key);
}

function save(){ try{ localStorage.setItem(SAVE_KEY, JSON.stringify({state,uid})); }catch(e){} }
function load(){
  try{
    const raw = localStorage.getItem(SAVE_KEY);
    if(!raw) return false;
    const d = JSON.parse(raw);
    if(!d || !d.state) return false;
    state = d.state; uid = d.uid || 1;
    // migrate older saves that predate liveries / tour-duration locking / deferred outcomes
    state.locos.forEach(l=>{ if(typeof l.livery!=="number") l.livery = 0; if(typeof l.busyUntil!=="number") l.busyUntil = 0; });
    state.rakes.forEach(r=>{ if(typeof r.busyUntil!=="number") r.busyUntil = 0; });
    if(!Array.isArray(state.activeTours)) state.activeTours = [];
    return true;
  }catch(e){ return false; }
}

/* ============================ HELPERS ============================ */
const money = n => "£"+Math.round(n).toLocaleString("en-GB");
function seasonName(){ return SEASONS[Math.floor((state.week-1)/6)%4]; }
function isFestive(){ return seasonName()==="Winter" && ((state.week-1)%6)>=3; }
function repFactor(){ return state.rep/100; }
function repTier(){
  const r=state.rep;
  if(r>=140) return "Legendary"; if(r>=110) return "Prestige";
  if(r>=80) return "Renowned"; if(r>=50) return "Established";
  if(r>=25) return "Regional"; return "Fledgling";
}
function condColour(c){ return c>0.6?"var(--good)":c>0.3?"var(--warn)":"var(--danger)"; }
function liveryOf(loco){
  const cat = catOf("loco", loco.cat);
  const i = (loco.livery!=null && cat.liveries[loco.livery]) ? loco.livery : 0;
  return cat.liveries[i];
}
function locoDraw(loco){ return catOf("loco",loco.cat).draw + liveryOf(loco).draw; }
function repaintCost(loco){ return Math.round(catOf("loco",loco.cat).cost*0.025) + 1500; }
// how many weeks a route ties up its stock (tour + positioning & servicing turnaround)
function routeWeeks(route){ return route.miles>130 ? 3 : route.miles>=90 ? 2 : 1; }
function isBusy(item){ return (item.busyUntil||0) > state.week; }
function weeksLeft(item){ return Math.max(0, (item.busyUntil||0) - state.week); }
function sellValue(kind, item){
  const cat = catOf(kind, item.cat);
  return Math.round(cat.cost * (0.35 + 0.4*item.condition));
}
function netWorth(){
  let w = state.cash;
  state.locos.forEach(l=> w+=sellValue("loco",l));
  state.rakes.forEach(r=> w+=sellValue("rake",r));
  return w;
}
function logEntry(text, delta){
  state.ledger.unshift({week:state.week, text, delta});
  if(state.ledger.length>200) state.ledger.pop();
}

/* ============================ TOUR MATHS ============================ */
function computeTour(loco, rake, route, roll){
  const lcat = catOf("loco", loco.cat);
  const rcat = catOf("rake", rake.cat);
  const season = seasonName();
  let sf = SEASON_FACTOR[season];
  if(isFestive()) sf += 0.45; // Santa specials

  // steam-favoured route bonus
  const affinity = (route.steamFavoured && loco.kind==="steam") ? 1.15
                 : (!route.steamFavoured && loco.kind==="diesel") ? 1.05 : 1.0;

  // effective public draw includes the loco's current livery
  const draw = locoDraw(loco);

  // ticket price
  const ticket = Math.round(
    route.baseFare * rcat.comfort * (0.82 + 0.16*draw) * (0.85 + 0.30*repFactor())
  );

  // demand
  let demand = route.baseDemand * draw * route.scenic * affinity * sf * (0.6 + 0.7*repFactor());
  const rnd = roll ? (0.82 + roll()*0.34) : 1.0;
  demand *= rnd;
  const passengers = Math.min(rcat.capacity, Math.round(demand));
  const loadFactor = passengers / rcat.capacity;
  const revenue = passengers * ticket;

  // overload
  const extraCars = Math.max(0, rcat.cars - lcat.maxHaul);
  const overloadCost = extraCars * 1900;

  // costs
  const fuel = lcat.runPerMile * route.miles;
  const crew = loco.kind==="steam" ? 3800 : 2400;
  const support = 900;
  const insurance = 600;
  const cost = fuel + crew + support + insurance + route.access + rcat.upkeep + overloadCost;

  // breakdown probability
  let pBreak = route.difficulty * (1.08 - loco.condition) / lcat.reliability * 0.34;
  pBreak += extraCars * 0.045;
  pBreak = Math.max(0.015, Math.min(0.6, pBreak));

  // wear this tour
  const wear = (route.miles/900) * lcat.wear * (loco.kind==="steam"?1.25:1.0) * (1+extraCars*0.12);

  return {season, ticket, passengers, capacity:rcat.capacity, loadFactor, revenue,
          fuel, crew, support, insurance, access:route.access, upkeep:rcat.upkeep,
          overloadCost, extraCars, cost, pBreak, wear, affinity, netExpected: revenue-cost};
}

// Roll the tour's outcome NOW but DO NOT touch game state — the result stays
// sealed until the tour returns (so a failure is only revealed on completion).
function resolveTour(loco, rake, route){
  let seed = (state.week*97 + loco.id*13 + rake.id*7 + route.miles) % 1000;
  const rng = ()=>{ seed = (seed*1103515245 + 12345) & 0x7fffffff; return (seed>>8)/0x7fffff; };
  const p = computeTour(loco, rake, route, rng);
  const events = [];
  let revenue = p.revenue, cost = p.cost, repDelta = 0, brokeDown = false;

  // breakdown check
  let locoCondDrop = p.wear;
  if(rng() < p.pBreak){
    brokeDown = true;
    const repair = Math.round(catOf("loco",loco.cat).cost * (0.06 + rng()*0.09));
    cost += repair;
    const refund = Math.round(revenue * (0.4 + rng()*0.25));
    revenue -= refund;
    repDelta -= 9;
    locoCondDrop += 0.12;
    events.push({cls:"bad", text:`💥 <b>Failure at speed.</b> ${loco.number} failed en route — a rescue loco was summoned. `+
      `Repairs cost ${money(repair)} and ${money(refund)} of fares were refunded. The enthusiast press are not kind.`});
  } else {
    // positive/flavour events
    const e = rng();
    if(e < 0.14){
      const bonus = Math.round(revenue*0.12);
      revenue += bonus;
      events.push({cls:"good", text:`📸 <b>Lineside crowds.</b> Photographers packed every overbridge — on-train sales added ${money(bonus)}.`});
      repDelta += 2;
    } else if(e < 0.24){
      const delay = Math.round(cost*0.08);
      cost += delay;
      events.push({cls:"", text:`⏱️ <b>Signal check.</b> A late-running service delayed the path; extra crew hours cost ${money(delay)}.`});
    } else if(e < 0.32 && p.loadFactor>0.85){
      events.push({cls:"good", text:`🎟️ <b>Sold out.</b> Every seat taken and a waiting list — word is spreading.`});
      repDelta += 3;
    }
  }

  // reputation from load & quality
  if(!brokeDown){
    repDelta += 2;
    if(p.loadFactor > 0.9) repDelta += 4;
    else if(p.loadFactor > 0.7) repDelta += 2;
    else if(p.loadFactor < 0.4) repDelta -= 3;
    if(locoDraw(loco) >= 1.4 && route.scenic >= 1.3) repDelta += 2; // marquee pairing
    if(catOf("rake",rake.cat).comfort >= 1.6) repDelta += 1;    // pullman polish
  }

  const net = revenue - cost;
  // plain, serialisable outcome — held on the active-tour record until completion
  return {routeKey:route.key, routeName:route.name, miles:route.miles, season:p.season,
          locoId:loco.id, locoNumber:loco.number, locoCatKey:loco.cat, rakeId:rake.id, rakeCatKey:rake.cat,
          passengers:p.passengers, capacity:p.capacity, ticket:p.ticket,
          revenue, cost, net, repDelta, brokeDown, events, locoCondDrop, rakeCondDrop:p.wear*0.4};
}

// Apply a sealed outcome to game state — called only when the tour returns.
function applyTourOutcome(o){
  state.cash += o.net;
  state.rep = Math.max(0, Math.min(160, state.rep + o.repDelta));
  const loco = state.locos.find(l=>l.id===o.locoId);
  const rake = state.rakes.find(r=>r.id===o.rakeId);
  if(loco) loco.condition = Math.max(0.03, Math.min(1, loco.condition - o.locoCondDrop));
  if(rake) rake.condition = Math.max(0.05, Math.min(1, rake.condition - o.rakeCondDrop));
  logEntry(`${o.brokeDown?"⚠️ Returned (FAILED) from":"Completed"} '${o.routeName}' with ${o.locoNumber} + ${catOf("rake",o.rakeCatKey).name}: `+
           `${o.passengers}/${o.capacity} seats @ ${money(o.ticket)}. Net ${o.net>=0?"+":""}${money(o.net)}.`, o.net);
}

