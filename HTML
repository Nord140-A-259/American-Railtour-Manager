function renderRun(){
  // keep selections valid — drop anything sold or now out on tour
  if(sel.loco){ const l=state.locos.find(x=>x.id===sel.loco); if(!l||isBusy(l)) sel.loco=null; }
  if(sel.rake){ const r=state.rakes.find(x=>x.id===sel.rake); if(!r||isBusy(r)) sel.rake=null; }

  document.getElementById("pick-loco").innerHTML = state.locos.length ? state.locos.map(l=>{
    const c=catOf("loco",l.cat); const lv=liveryOf(l);
    const busy=isBusy(l); const usable = l.condition>=0.15 && !busy;
    const note = busy ? ` · 🚂 out on tour — returns wk ${l.busyUntil}` : (l.condition<0.15 ? ' · needs works' : '');
    return `<div class="opt ${sel.loco===l.id?'sel':''} ${usable?'':'disabled'}"
        ${usable?`onclick="pick('loco',${l.id})"`:''}>
      <b><span class="swatch" style="background:${lv.colour}"></span>${l.number}</b>
      <span class="mini">${c.name} · ${lv.name} · draw ${locoDraw(l).toFixed(2)}× · ${Math.round(l.condition*100)}% cond${note}</span>
    </div>`;
  }).join("") : `<div class="empty">Buy a loco first.</div>`;

  document.getElementById("pick-rake").innerHTML = state.rakes.length ? state.rakes.map(r=>{
    const c=catOf("rake",r.cat);
    const busy=isBusy(r); const usable = r.condition>=0.1 && !busy;
    const note = busy ? ` · out on tour — returns wk ${r.busyUntil}` : (r.condition<0.1 ? ' · needs works' : '');
    return `<div class="opt ${sel.rake===r.id?'sel':''} ${usable?'':'disabled'}"
        ${usable?`onclick="pick('rake',${r.id})"`:''}>
      <b>${c.name}</b>
      <span class="mini">${c.capacity} seats · ${c.cars} coaches · ${Math.round(r.condition*100)}% cond${note}</span>
    </div>`;
  }).join("") : `<div class="empty">Buy a rake first.</div>`;

  document.getElementById("pick-route").innerHTML = ROUTES.map(rt=>`
    <div class="opt ${sel.route===rt.key?'sel':''}" onclick="pick('route','${rt.key}')">
      <b>${rt.name} ${rt.steamFavoured?'🚂':''}</b>
      <span class="mini">${rt.miles} mi · scenic ${rt.scenic.toFixed(2)}× · access ${money(rt.access)}<br>${rt.blurb}</span>
    </div>`).join("");

  renderProjection();
}

function renderProjection(){
  const box = document.getElementById("projection");
  const loco = state.locos.find(l=>l.id===sel.loco);
  const rake = state.rakes.find(r=>r.id===sel.rake);
  const route = ROUTES.find(r=>r.key===sel.route);
  if(!loco || !rake || !route){
    box.innerHTML = `<div class="projection"><p class="sub">Select a locomotive, a carriage set and a route to see the projection.</p></div>`;
    return;
  }
  const p = computeTour(loco, rake, route, null);
  const riskCls = p.pBreak<0.12?"risk-lo":p.pBreak<0.28?"risk-md":"risk-hi";
  const riskWord = p.pBreak<0.12?"Low":p.pBreak<0.28?"Moderate":"High";
  const overloadNote = p.extraCars>0
    ? `<div class="event bad">⚠️ Overloaded: this rake has ${p.extraCars} coach(es) beyond ${catOf("loco",loco.cat).name}'s comfortable haul. Expect an assisting-loco charge of ${money(p.overloadCost)} and a higher failure risk.</div>`
    : "";
  const affNote = p.affinity>1.05
    ? `<div class="event good">✓ Enthusiast favourite: this pairing suits the route — crowds up.</div>` : "";
  box.innerHTML = `<div class="projection">
    <h3 style="margin-top:0">Projected: ${route.name}</h3>
    ${affNote}${overloadNote}
    <div class="proj-grid">
      <div class="proj-cell"><b>${money(p.ticket)}</b><span>Ticket</span></div>
      <div class="proj-cell"><b>${p.passengers}/${p.capacity}</b><span>Seats (${Math.round(p.loadFactor*100)}%)</span></div>
      <div class="proj-cell"><b>${money(p.revenue)}</b><span>Revenue</span></div>
      <div class="proj-cell"><b>${money(p.cost)}</b><span>Costs</span></div>
      <div class="proj-cell"><b class="${p.netExpected>=0?'pos':'neg'}">${p.netExpected>=0?'+':''}${money(p.netExpected)}</b><span>Est. profit</span></div>
      <div class="proj-cell"><b class="${riskCls}">${riskWord}</b><span>Failure risk</span></div>
    </div>
    <p class="sub">Cost breakdown: fuel/coal ${money(p.fuel)} · crew ${money(p.crew)} · support ${money(p.support)} · track access ${money(p.access)} · rake upkeep ${money(p.upkeep)} · insurance ${money(p.insurance)}${p.overloadCost?` · assist ${money(p.overloadCost)}`:''}. Season: ${p.season}${isFestive()?' (festive boost)':''}.</p>
    <div class="event">🚂 These are <b>projections</b>. Dispatching ties up the loco and carriage set for <b>${routeWeeks(route)} week${routeWeeks(route)>1?'s':''}</b> (returns week ${state.week + routeWeeks(route)}) — and you'll only learn how it actually went, including any failure, once the train is back.</div>
    <button class="act" onclick="departTour()">🚦 Dispatch this railtour</button>
  </div>`;
}

function renderWorks(){
  const box = document.getElementById("works-list");
  const items = [];
  state.locos.forEach(l=>{
    const cat=catOf("loco",l.cat);
    const full = Math.round(cat.cost*0.5*(1-l.condition)+400);
    const svc = Math.round(cat.cost*0.22*(0.8-l.condition>0?0.8-l.condition:0.15)+250);
    const busy = isBusy(l);
    items.push(`<div class="card">
      <h3><span class="badge ${l.kind==='steam'?'b-steam':'b-diesel'}">${l.kind}</span>${l.number}</h3>
      <p class="sub">${cat.name}</p>
      ${busy?`<div class="busy-tag">🚂 Out on tour — returns week ${l.busyUntil}</div>`:''}
      <div class="cond-lbl"><span>Condition</span><span>${Math.round(l.condition*100)}%</span></div>
      <div class="bar"><i style="width:${l.condition*100}%;background:${condColour(l.condition)}"></i></div>
      <button class="act small" ${busy||l.condition>=0.99||state.cash<svc?'disabled':''} onclick="service('loco',${l.id})">Service to 80% · ${money(svc)}</button>
      <button class="act small warnbtn" ${busy||l.condition>=0.99||state.cash<full?'disabled':''} onclick="overhaul('loco',${l.id})">Full overhaul · ${money(full)}</button>
    </div>`);
  });
  state.rakes.forEach(r=>{
    const cat=catOf("rake",r.cat);
    const full = Math.round(cat.cost*0.45*(1-r.condition)+300);
    const busy = isBusy(r);
    items.push(`<div class="card">
      <h3><span class="badge b-rake">rake</span>${cat.name}</h3>
      ${busy?`<div class="busy-tag">🚃 Out on tour — returns week ${r.busyUntil}</div>`:''}
      <div class="cond-lbl"><span>Condition</span><span>${Math.round(r.condition*100)}%</span></div>
      <div class="bar"><i style="width:${r.condition*100}%;background:${condColour(r.condition)}"></i></div>
      <button class="act small warnbtn" ${busy||r.condition>=0.99||state.cash<full?'disabled':''} onclick="overhaul('rake',${r.id})">Refurbish to as-new · ${money(full)}</button>
    </div>`);
  });
  box.innerHTML = items.length?items.join(""):`<div class="empty">Nothing in the fleet yet.</div>`;
}

function renderLedger(){
  document.getElementById("ledger-body").innerHTML = state.ledger.map(e=>`
    <tr><td>Wk ${e.week} — ${e.text}</td>
    <td class="${e.delta>0?'pos':e.delta<0?'neg':''}">${e.delta?((e.delta>0?'+':'')+money(e.delta)):''}</td></tr>`).join("");
}

/* ============================ ACTIONS ============================ */
function buyLoco(key){
  const c = catOf("loco",key); if(state.cash<c.cost) return;
  state.cash -= c.cost;
  state.locos.push(mkLoco(c, 1.0));
  logEntry(`Purchased ${c.name} (${c.number}).`, -c.cost);
  render();
}
function buyRake(key){
  const c = catOf("rake",key); if(state.cash<c.cost) return;
  state.cash -= c.cost;
  state.rakes.push(mkRake(c, 1.0));
  logEntry(`Purchased ${c.name}.`, -c.cost);
  render();
}
function sellItem(kind,id){
  const arr = kind==="loco"?state.locos:state.rakes;
  const i = arr.findIndex(x=>x.id===id); if(i<0) return;
  const item = arr[i]; const v = sellValue(kind,item);
  if(!confirm(`Sell ${item.number||catOf(kind,item.cat).name} for ${money(v)}?`)) return;
  state.cash += v; arr.splice(i,1);
  logEntry(`Sold ${item.number||catOf(kind,item.cat).name}.`, v);
  render();
}
function repaint(id, idx){
  const loco = state.locos.find(l=>l.id===id); if(!loco) return;
  idx = parseInt(idx,10);
  if(idx===loco.livery){ render(); return; }
  const cat = catOf("loco",loco.cat);
  const fee = repaintCost(loco);
  if(state.cash < fee){ alert("Not enough cash to repaint."); render(); return; }
  if(!confirm(`Repaint ${loco.number} into ${cat.liveries[idx].name} for ${money(fee)}?`)){ render(); return; }
  state.cash -= fee; loco.livery = idx;
  logEntry(`Repainted ${loco.number} into ${cat.liveries[idx].name}.`, -fee);
  render();
}
function service(kind,id){
  const item = (kind==="loco"?state.locos:state.rakes).find(x=>x.id===id); if(!item) return;
  const cat=catOf(kind,item.cat);
  const cost = Math.round(cat.cost*0.22*(0.8-item.condition>0?0.8-item.condition:0.15)+250);
  if(state.cash<cost) return;
  state.cash -= cost; item.condition = Math.max(item.condition, 0.8);
  logEntry(`Serviced ${item.number||cat.name} to 80%.`, -cost);
  render();
}
function overhaul(kind,id){
  const item = (kind==="loco"?state.locos:state.rakes).find(x=>x.id===id); if(!item) return;
  const cat=catOf(kind,item.cat);
  const cost = Math.round(cat.cost*(kind==="loco"?0.5:0.45)*(1-item.condition)+(kind==="loco"?400:300));
  if(state.cash<cost) return;
  state.cash -= cost; item.condition = 1.0;
  logEntry(`Full overhaul of ${item.number||cat.name}.`, -cost);
  render();
}

function pick(what,id){
  sel[what] = (what==="route") ? id : parseInt(id,10);
  renderRun();
}

function departTour(){
  const loco = state.locos.find(l=>l.id===sel.loco);
  const rake = state.rakes.find(r=>r.id===sel.rake);
  const route = ROUTES.find(r=>r.key===sel.route);
  if(!loco||!rake||!route) return;
  if(isBusy(loco)||isBusy(rake)) return; // safety: can't dispatch stock already out
  const dur = routeWeeks(route);
  const returnsWeek = state.week + dur;
  // roll the outcome now but keep it sealed until the tour returns
  const outcome = resolveTour(loco, rake, route);
  state.activeTours.push({returnsWeek, dur, outcome});
  loco.busyUntil = returnsWeek;
  rake.busyUntil = returnsWeek;
  sel.loco = null; sel.rake = null; // both are now out on the road
  logEntry(`Dispatched ${loco.number} + ${catOf("rake",rake.cat).name} on '${route.name}' — due back week ${returnsWeek}.`, 0);
  openModal("Railtour Dispatched", `
    <p><b>${route.name}</b> · ${route.miles} miles · ${seasonName()}</p>
    <p>${loco.number} <span class="sub" style="font-style:normal">(${catOf("loco",loco.cat).name})</span> and the ${catOf("rake",rake.cat).name} have set off.</p>
    <div class="event">🚂 The train is on the road. It's due back in <b>week ${returnsWeek}</b> (${dur} week${dur>1?'s':''}) — you'll find out how the tour went, good or bad, when it returns. Press <b>Advance One Week</b> to pass the time.</div>`);
  render();
}

function advanceWeek(){
  state.week++;
  // any tours that have now returned resolve and report — this is where a failure surfaces
  const returned = state.activeTours.filter(t=>t.returnsWeek<=state.week);
  state.activeTours = state.activeTours.filter(t=>t.returnsWeek>state.week);
  returned.forEach(t=>applyTourOutcome(t.outcome));
  render();
  if(returned.length) showCompletedReports(returned.map(t=>t.outcome));
  checkBankruptcy();
}

function checkBankruptcy(){
  if(state.cash < 0){
    // give a chance if they can sell; only bust if net worth also negative
    if(netWorth() < 0){
      openModal("Receivership", `<p>Your balance is ${money(state.cash)} and there are no assets left to realise. The company has gone into receivership.</p>
        <p>You reached <b>Week ${state.week}</b> with a reputation of <b>${state.rep}</b> (${repTier()}).</p>
        <button class="act warnbtn" onclick="closeModal();newGame();">Start a new company</button>`, true);
    }
  }
}

/* ============================ REPORT MODAL ============================ */
// One returned tour's outcome, rendered as a report section.
function outcomeSection(o){
  const loco = state.locos.find(l=>l.id===o.locoId);
  const cond = loco ? Math.round(loco.condition*100)+"%" : "—";
  const evHtml = o.events.length ? o.events.map(e=>`<div class="event ${e.cls}">${e.text}</div>`).join("") : "";
  return `
    <div class="report-block ${o.brokeDown?'failed':''}">
      <p><b>${o.routeName}</b> · ${o.miles} miles · ${o.season}${o.brokeDown?` · <span class="neg">FAILED</span>`:''}</p>
      <p>${o.locoNumber} <span class="sub" style="font-style:normal">(${catOf("loco",o.locoCatKey).name})</span> hauling the ${catOf("rake",o.rakeCatKey).name}.</p>
      ${evHtml}
      <div class="proj-grid">
        <div class="proj-cell"><b>${o.passengers}/${o.capacity}</b><span>Seats sold</span></div>
        <div class="proj-cell"><b>${money(o.revenue)}</b><span>Revenue</span></div>
        <div class="proj-cell"><b>${money(o.cost)}</b><span>Costs</span></div>
        <div class="proj-cell"><b class="${o.net>=0?'pos':'neg'}">${o.net>=0?'+':''}${money(o.net)}</b><span>Net result</span></div>
        <div class="proj-cell"><b class="${o.repDelta>=0?'pos':'neg'}">${o.repDelta>=0?'+':''}${o.repDelta}</b><span>Reputation</span></div>
        <div class="proj-cell"><b>${cond}</b><span>Loco condition</span></div>
      </div>
    </div>`;
}
function showCompletedReports(outcomes){
  const head = outcomes.length>1
    ? `${outcomes.length} Railtours Returned — Week ${state.week}`
    : (outcomes[0].brokeDown ? `Railtour Returned — Failure — Week ${state.week}` : `Railtour Returned — Week ${state.week}`);
  const body = outcomes.map(outcomeSection).join(`<hr style="border:none;border-top:1px solid var(--line);margin:14px 0">`)
    + `<p class="sub">Balance now ${money(state.cash)} · reputation ${state.rep} (${repTier()}) · net worth ${money(netWorth())}.</p>`;
  openModal(head, body);
}

/* ============================ MODAL / TABS / BOOT ============================ */
function openModal(head, body, noClose){
  document.getElementById("modalHead").textContent = head;
  document.getElementById("modalBody").innerHTML = body;
  document.getElementById("modalClose").style.display = noClose?"none":"block";
  document.getElementById("modalBg").classList.add("show");
}
function closeModal(){ document.getElementById("modalBg").classList.remove("show"); }

document.getElementById("modalClose").onclick = closeModal;
document.getElementById("modalBg").addEventListener("click", e=>{ if(e.target.id==="modalBg") closeModal(); });
document.getElementById("btn-advance").onclick = advanceWeek;

document.querySelectorAll(".tabs button").forEach(b=>{
  b.onclick = ()=>{
    document.querySelectorAll(".tabs button").forEach(x=>x.classList.remove("active"));
    document.querySelectorAll(".view").forEach(x=>x.classList.remove("active"));
    b.classList.add("active");
    document.getElementById("v-"+b.dataset.tab).classList.add("active");
  };
});
document.getElementById("btn-newgame").onclick = ()=>{
  if(confirm("Abandon your current company and start fresh?")){ newGame(); }
};

if(!load()){ newGame(); } else { render(); }
</script>
</body>
</html>
